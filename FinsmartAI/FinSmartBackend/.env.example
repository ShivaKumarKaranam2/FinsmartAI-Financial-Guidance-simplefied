# =====================================================================
# FinSmart AI Backend - Environment Configuration Template
# =====================================================================

# --- NVIDIA NIM API (Primary LLM Provider) ---
# Get your key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_LLM_MODEL=meta/llama-3.3-70b-instruct
RAG_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# --- Fine-tuned HuggingFace QA Model (used for RAG Document Q&A) ---
# Your fine-tuned gemma model on HuggingFace Hub
QA_HF_MODEL=Shiva-k22/gemma-FinAI

# --- Fine-tuned gemma-FinAI Gradio Space (Tier 1 primary) ---
# Use the Space RUNTIME host (…hf.space), NOT the web page URL.
# The web URL huggingface.co/spaces/owner/name is auto-converted if supplied.
GEMMA_FINAI_SPACE_URL=https://shiva-k22-gemma-finai-demo.hf.space
# Gradio API function name exposed by the Space (default: /bot_reply)
GEMMA_FINAI_SPACE_FN=/bot_reply

# --- DataStax AstraDB (FinRAG Vector Store) ---
# Create database at: https://astra.datastax.com
ASTRA_DB_API_ENDPOINT=https://your-astra-db-id-region.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your_application_token_here
COLLECTION_NAME=finrag_nvidia_v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=hf_your_huggingface_token_here

# --- Market Sentiment & News ---
# Marketaux API for Indian Market News: https://www.marketaux.com
MARKETAUX_API_KEY=your_marketaux_api_key_here

# Financial Datasets API: https://financialdatasets.ai
FD_API_KEY=your_financial_datasets_api_key_here

# --- Search Tools (CrewAI Multi-Agent Research) ---
# Tavily Search API: https://tavily.com
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Optional: Serper API for Google Search: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here
